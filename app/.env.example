# Copy to .env.local and fill in. Leave all three EMPTY to run in LOCAL DEVELOPMENT MODE
# (projects saved in this browser only; clearly labelled in the UI).

# Supabase project URL, e.g. https://abcdefgh.supabase.co   (public)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase "anon" / publishable key                           (public: safe in the browser; row-level security protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase "service_role" key. PRIVILEGED: bypasses row-level security.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit it, never paste it into client code.
# Set it in your host's secret environment variables (e.g. Vercel -> Settings -> Environment Variables, not exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=
